@model List<Booking>
@{
    ViewData["Title"] = "Rental History";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-clock-history me-2 text-gradient"></i>Rental History Report</h2>
    <p>Complete history of all rentals in the system.</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No rental records found.</div>
}
else
{
    <div class="d-flex flex-wrap gap-2 mb-4 scroll-animate">
        <span class="badge bg-warning" style="font-size:0.85rem;padding:0.5rem 1rem;"><i class="bi bi-hourglass-split me-1"></i>Pending: @Model.Count(b => b.Status == BookingStatus.Pending)</span>
        <span class="badge bg-success" style="font-size:0.85rem;padding:0.5rem 1rem;"><i class="bi bi-check-circle me-1"></i>Approved: @Model.Count(b => b.Status == BookingStatus.Approved)</span>
        <span class="badge bg-info" style="font-size:0.85rem;padding:0.5rem 1rem;"><i class="bi bi-flag me-1"></i>Completed: @Model.Count(b => b.Status == BookingStatus.Completed)</span>
        <span class="badge bg-danger" style="font-size:0.85rem;padding:0.5rem 1rem;"><i class="bi bi-x-circle me-1"></i>Rejected: @Model.Count(b => b.Status == BookingStatus.Rejected)</span>
        <span class="badge bg-secondary" style="font-size:0.85rem;padding:0.5rem 1rem;"><i class="bi bi-slash-circle me-1"></i>Cancelled: @Model.Count(b => b.Status == BookingStatus.Cancelled)</span>
    </div>

    <div class="vrms-table scroll-animate">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Start</th>
                        <th>End</th>
                        <th>Days</th>
                        <th>Cost</th>
                        <th>Status</th>
                        <th>Paid</th>
                        <th>Booked On</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        <tr>
                            <td><strong>#@b.Id</strong></td>
                            <td>@b.Customer.FullName</td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(b.Vehicle.ImageUrl))
                                    {
                                        <img src="@b.Vehicle.ImageUrl" alt="@b.Vehicle.Brand @b.Vehicle.Model" style="width:32px;height:32px;border-radius:6px;min-width:32px;object-fit:cover;" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="vehicle-img-placeholder @b.Vehicle.Type.ToString().ToLower()" style="width:32px;height:32px;border-radius:6px;min-width:32px;">
                                            <i class="bi bi-car-front-fill" style="font-size:0.8rem;"></i>
                                        </div>
                                    }
                                    <span class="ms-2">@b.Vehicle.Brand @b.Vehicle.Model</span>
                                </div>
                            </td>
                            <td>@b.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@b.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>@((b.EndDate - b.StartDate).Days)</td>
                            <td><strong>₹@b.TotalCost.ToString("N2")</strong></td>
                            <td>
                                @switch (b.Status)
                                {
                                    case BookingStatus.Pending: <span class="badge bg-warning">Pending</span> break;
                                    case BookingStatus.Approved: <span class="badge bg-success">Active</span> break;
                                    case BookingStatus.Completed: <span class="badge bg-info">Completed</span> break;
                                    case BookingStatus.Rejected: <span class="badge bg-danger">Rejected</span> break;
                                    case BookingStatus.Cancelled: <span class="badge bg-secondary">Cancelled</span> break;
                                }
                            </td>
                            <td>
                                @if (b.Payment != null)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle"></i></span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>@b.CreatedAt.ToString("MMM dd, yyyy")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Reports
    </a>
</div>

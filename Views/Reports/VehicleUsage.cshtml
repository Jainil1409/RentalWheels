@model vehicle_management_system_mvc.Helpers.PaginatedList<Vehicle>
@{
    ViewData["Title"] = "Vehicle Usage Report";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-speedometer2 me-2 text-gradient"></i>Vehicle Usage Report</h2>
    <p>Vehicles sorted by total number of bookings.</p>
</div>

<div class="card shadow-sm border-0 mb-4 animate-fade-in-up scroll-animate">
    <div class="card-body">
        <form asp-action="VehicleUsage" method="get" class="d-flex w-100 gap-2" id="searchForm">
            <div class="input-group shadow-sm rounded">
                <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 bg-light" placeholder="Search by brand, model, or type...">
                <button type="submit" class="btn btn-primary px-4 rounded-end"><i class="bi bi-search me-1"></i>Search</button>
            </div>
            @if (!string.IsNullOrEmpty((string?)ViewData["CurrentFilter"]))
            {
                <a asp-action="VehicleUsage" class="btn btn-outline-secondary px-4 d-flex align-items-center shadow-sm rounded"><i class="bi bi-x-circle me-2"></i>Clear</a>
            }
        </form>
    </div>
</div>

<div class="vrms-table scroll-animate">
    <div class="table-responsive">
        <table class="table table-hover">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Vehicle</th>
                    <th>Type</th>
                    <th>Year</th>
                    <th>Price/Day</th>
                    <th>Status</th>
                    <th>Total Bookings</th>
                </tr>
            </thead>
            <tbody>
                @{ var index = (Model.PageIndex - 1) * 10 + 1; }
                @foreach (var vehicle in Model)
                {
                    <tr>
                        <td><strong>@(index++)</strong></td>
                        <td>
                            <div class="d-flex align-items-center">
                                @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                                {
                                    <img src="@vehicle.ImageUrl" alt="@vehicle.Brand @vehicle.Model" style="width:40px;height:40px;border-radius:8px;min-width:40px;object-fit:cover;" loading="lazy" />
                                }
                                else
                                {
                                    <div class="vehicle-img-placeholder @vehicle.Type.ToString().ToLower()" style="width:40px;height:40px;border-radius:8px;min-width:40px;">
                                        <i class="bi bi-car-front-fill" style="font-size:1rem;"></i>
                                    </div>
                                }
                                <strong class="ms-2">@vehicle.Brand @vehicle.Model</strong>
                            </div>
                        </td>
                        <td><span class="badge bg-primary">@vehicle.Type</span></td>
                        <td>@vehicle.Year</td>
                        <td><strong>₹@vehicle.PricePerDay.ToString("N2")</strong></td>
                        <td>
                            @if (vehicle.IsAvailable)
                            {
                                <span class="badge bg-success">Available</span>
                            }
                            else
                            {
                                <span class="badge bg-danger">Unavailable</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-info" style="font-size:0.85rem;padding:0.4rem 0.8rem;">
                                <i class="bi bi-calendar-check me-1"></i>@vehicle.Bookings.Count bookings
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <div>
        <span class="text-muted">Page @(Model.TotalPages < Model.PageIndex ? 0 : Model.PageIndex) of @Model.TotalPages</span>
    </div>
    <ul class="pagination mb-0">
        <li class="page-item @(!Model.HasPreviousPage ? "disabled" : "")">
            <a class="page-link shadow-sm rounded-start" href="/Reports/VehicleUsage?pageNumber=@(Model.PageIndex - 1)&searchString=@ViewData["CurrentFilter"]">
                <i class="bi bi-chevron-left me-1"></i> Previous
            </a>
        </li>
        <li class="page-item @(!Model.HasNextPage ? "disabled" : "")">
            <a class="page-link shadow-sm rounded-end ms-1" href="/Reports/VehicleUsage?pageNumber=@(Model.PageIndex + 1)&searchString=@ViewData["CurrentFilter"]">
                Next <i class="bi bi-chevron-right ms-1"></i>
            </a>
        </li>
    </ul>
</div>

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Reports
    </a>
</div>

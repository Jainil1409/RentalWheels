@model List<Payment>
@{
    ViewData["Title"] = "Payment Report";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-cash-coin me-2 text-gradient"></i>Payment Report</h2>
    <p>Summary of all payment transactions.</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info"><i class="bi bi-info-circle me-2"></i>No payment records found.</div>
}
else
{
    <div class="row g-4 mb-4">
        <div class="col-md-3 scroll-animate">
            <div class="stat-card success">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-value" data-count="@Model.Where(p => p.Status == PaymentStatus.Completed).Sum(p => p.Amount)" data-prefix="₹" data-decimals="2">₹0</div>
                <div class="stat-label">Total Collected</div>
            </div>
        </div>
        <div class="col-md-3 scroll-animate">
            <div class="stat-card primary">
                <div class="stat-icon"><i class="bi bi-receipt"></i></div>
                <div class="stat-value" data-count="@Model.Count">0</div>
                <div class="stat-label">Total Transactions</div>
            </div>
        </div>
        <div class="col-md-3 scroll-animate">
            <div class="stat-card info">
                <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="stat-value" data-count="@Model.Count(p => p.Method == PaymentMethod.Cash)">0</div>
                <div class="stat-label">Cash</div>
            </div>
        </div>
        <div class="col-md-3 scroll-animate">
            <div class="stat-card warning">
                <div class="stat-icon"><i class="bi bi-stripe"></i></div>
                <div class="stat-value" data-count="@Model.Count(p => p.Method == PaymentMethod.Stripe)">0</div>
                <div class="stat-label">Stripe</div>
            </div>
        </div>
    </div>

    <div class="vrms-table scroll-animate">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td><strong>#@p.Id</strong></td>
                            <td>@p.Booking.Customer.FullName</td>
                            <td>@p.Booking.Vehicle.Brand @p.Booking.Vehicle.Model</td>
                            <td><strong>₹@p.Amount.ToString("N2")</strong></td>
                            <td><span class="badge bg-primary">@p.Method</span></td>
                            <td>
                                @switch (p.Status)
                                {
                                    case PaymentStatus.Completed: <span class="badge bg-success">Completed</span> break;
                                    case PaymentStatus.Pending: <span class="badge bg-warning">Pending</span> break;
                                    case PaymentStatus.Failed: <span class="badge bg-danger">Failed</span> break;
                                    case PaymentStatus.Refunded: <span class="badge bg-info">Refunded</span> break;
                                }
                            </td>
                            <td>@p.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

<div class="mt-3">
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Reports
    </a>
</div>

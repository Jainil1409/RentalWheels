<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>Jainil's RentWheels | Online Car Rental Platform</title>

<meta name="description" content="Jainil's RentWheels is a modern vehicle rental management system where users can easily rent cars, check vehicle availability, and manage bookings online.">

<meta name="keywords" content="Jainil's RentWheels, RentWheels, car rental system, vehicle rental system, book car online, rent car Gujarat, Ahmedabad car rental, online car booking">

<meta name="author" content="Jainil Vyas">

<meta name="robots" content="index, follow">

<meta name="google-site-verification" content="wYVcCqeiG-YMpYmG_bP5vmu8ic5zIMWcXwltC7JSlLI">

<link rel="canonical" href="https://rentwheels.onrender.com/">

<!-- Open Graph -->
<meta property="og:title" content="Jainil's RentWheels | Online Vehicle Rental System">
<meta property="og:description" content="Book cars easily with Jainil's RentWheels vehicle rental platform. Simple, fast, and reliable car rental system.">
<meta property="og:image" content="https://rentwheels.onrender.com/images/logo.png">
<meta property="og:url" content="https://rentwheels.onrender.com/">
<meta property="og:type" content="website">

<!-- Twitter SEO -->
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Jainil's RentWheels">
<meta name="twitter:description" content="Book cars online using Jainil's RentWheels vehicle rental system.">
<meta name="twitter:image" content="https://rentwheels.onrender.com/images/logo.png">

<title>@ViewData["Title"] - Jainil's RentWheels</title>

<script type="importmap"></script>

<link rel="icon" type="image/png" href="~/images/logo.png" />

<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

@RenderSection("Styles", required: false)

<!-- Structured Data for Google -->
<script type="application/ld+json">
{
 "@@type": "CarRental",
 "name": "Jainil's RentWheels",
 "url": "https://rentwheels.onrender.com/",
 "logo": "https://rentwheels.onrender.com/images/logo.png",
 "description": "Online vehicle rental management system where users can rent cars easily.",
 "address": {
   "@@type": "PostalAddress",
   "addressLocality": "Ahmedabad",
   "addressRegion": "Gujarat",
   "addressCountry": "India"
 },
 "contactPoint": {
   "@@type": "ContactPoint",
   "telephone": "+91 9999000099",
   "contactType": "Customer Support"
 }
}
</script>

</head>

<body class="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin") ? "admin-layout" : "")">

<header>
<nav class="navbar navbar-expand-lg vrms-navbar fixed-top">
<div class="container">

<a class="navbar-brand" asp-controller="Home" asp-action="Index">
<img src="~/images/logo.png" alt="Jainil's RentWheels" height="50" class="me-2">
RentWheels
</a>

<button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
<i class="bi bi-list text-white fs-4"></i>
</button>

<div class="collapse navbar-collapse" id="navbarMain">

<ul class="navbar-nav me-auto ms-3">

<li class="nav-item">
<a class="nav-link" asp-controller="Home" asp-action="Index">
<i class="bi bi-house-door me-1"></i>Home
</a>
</li>

<li class="nav-item">
<a class="nav-link" asp-controller="Vehicles" asp-action="Index">
<i class="bi bi-car-front me-1"></i>Vehicles
</a>
</li>

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer"))
{
<li class="nav-item">
<a class="nav-link" asp-controller="Bookings" asp-action="MyBookings">
<i class="bi bi-calendar-check me-1"></i>My Bookings
</a>
</li>
}

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
{
<li class="nav-item dropdown">

<a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
<i class="bi bi-shield-lock me-1"></i>Admin
</a>

<ul class="dropdown-menu">

<li>
<a class="dropdown-item" asp-controller="Vehicles" asp-action="Create">
<i class="bi bi-plus-circle me-2"></i>Add Vehicle
</a>
</li>

<li>
<a class="dropdown-item" asp-controller="Bookings" asp-action="AllBookings">
<i class="bi bi-journal-text me-2"></i>All Bookings
</a>
</li>

<li>
<a class="dropdown-item" asp-controller="Payments" asp-action="Index">
<i class="bi bi-credit-card me-2"></i>Payments
</a>
</li>

<li><hr class="dropdown-divider" /></li>

<li>
<a class="dropdown-item" asp-controller="Reports" asp-action="Index">
<i class="bi bi-graph-up me-2"></i>Reports Dashboard
</a>
</li>

<li>
<a class="dropdown-item" asp-controller="Reports" asp-action="VehicleUsage">
<i class="bi bi-speedometer2 me-2"></i>Vehicle Usage
</a>
</li>

<li>
<a class="dropdown-item" asp-controller="Reports" asp-action="RentalHistory">
<i class="bi bi-clock-history me-2"></i>Rental History
</a>
</li>

<li>
<a class="dropdown-item" asp-controller="Reports" asp-action="PaymentReport">
<i class="bi bi-cash-stack me-2"></i>Payment Report
</a>
</li>

</ul>
</li>
}

</ul>

<ul class="navbar-nav ms-auto">

@if (User.Identity?.IsAuthenticated == true)
{
<li class="nav-item d-flex align-items-center me-2">
<span class="navbar-user-info">

<span class="user-avatar">
@(User.Identity.Name?.Substring(0, 1).ToUpper())
</span>

@User.Identity.Name

</span>
</li>

<li class="nav-item">
<form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
@Html.AntiForgeryToken()

<button type="submit" class="btn btn-nav-logout btn-sm">
<i class="bi bi-box-arrow-right me-1"></i>Logout
</button>

</form>
</li>
}
else
{
<li class="nav-item">
<a class="nav-link" asp-controller="Account" asp-action="Login">
<i class="bi bi-box-arrow-in-right me-1"></i>Login
</a>
</li>

<li class="nav-item">
<a class="btn btn-primary btn-sm ms-2" asp-controller="Account" asp-action="Register">
<i class="bi bi-person-plus me-1"></i>Register
</a>
</li>
}

</ul>

</div>
</div>
</nav>
</header>

<div style="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin") ? "" : "padding-top: 70px;")">

@if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
{
await Html.RenderPartialAsync("_AdminSidebar");

<button class="sidebar-mobile-toggle d-lg-none" id="sidebarToggle">
<i class="bi bi-list"></i>
</button>
}

<div class="@(User.Identity?.IsAuthenticated == true && User.IsInRole("Admin") ? "admin-main-content" : "container") main-content">

@if (TempData["Success"] != null)
{
<div class="alert alert-success alert-dismissible fade show">
<i class="bi bi-check-circle-fill me-2"></i>@TempData["Success"]
<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

@if (TempData["Error"] != null)
{
<div class="alert alert-danger alert-dismissible fade show">
<i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["Error"]
<button type="button" class="btn-close" data-bs-dismiss="alert"></button>
</div>
}

<main role="main">
@RenderBody()
</main>

</div>
</div>

<footer class="vrms-footer">

<div class="container">

<div class="row">

<div class="col-lg-4 mb-4 mb-lg-0">

<div class="footer-brand">
<img src="~/images/logo.png" alt="RentWheels">
<span>RentWheels</span>
</div>

<p class="footer-description">
Your trusted vehicle rental management platform. Find the perfect vehicle for every journey.
</p>

</div>

<div class="col-lg-2 col-md-4 mb-4 mb-md-0">

<h6>Quick Links</h6>

<ul class="footer-links">
<li><a asp-controller="Home" asp-action="Index">Home</a></li>
<li><a asp-controller="Vehicles" asp-action="Index">Vehicles</a></li>
<li><a asp-controller="Home" asp-action="Privacy">Privacy</a></li>
</ul>

</div>

<div class="col-lg-2 col-md-4 mb-4 mb-md-0">

<h6>Vehicle Types</h6>

<ul class="footer-links">
<li><a href="#">Sedan</a></li>
<li><a href="#">SUV</a></li>
<li><a href="#">Luxury</a></li>
<li><a href="#">Hatchback</a></li>
<li><a href="#">Truck</a></li>
</ul>

</div>

<div class="col-lg-4 col-md-4">

<h6>Contact</h6>

<ul class="footer-links">
<li><i class="bi bi-envelope me-2"></i>support@rentwheels.com</li>
<li><i class="bi bi-telephone me-2"></i>+91 9999000099</li>
<li><i class="bi bi-geo-alt me-2"></i>Ahmedabad, Gujarat, India</li>
</ul>

</div>

</div>

<div class="footer-bottom">

<p>&copy; @DateTime.Now.Year RentWheels. All rights reserved.</p>

<p>
<a asp-controller="Home" asp-action="Privacy" style="color: rgba(255,255,255,0.5);">
Privacy Policy
</a>
</p>

</div>

</div>

</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>

<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)

</body>
</html>
@using Microsoft.EntityFrameworkCore
@using vehicle_management_system_mvc.Data
@using vehicle_management_system_mvc.Models
@inject ApplicationDbContext _context

@{
    int pendingCount = 0;
    try {
        var pendingBookingsCount = await _context.Bookings.CountAsync(b => b.Status == BookingStatus.Pending);
        var pendingVerificationsCount = await _context.Users.CountAsync(u => u.Role == UserRole.Customer && !u.IsVerified && !string.IsNullOrEmpty(u.DriverLicenseNumber));
        var unreadNotificationsCount = await _context.Notifications.CountAsync(n => !n.IsRead && n.UserId == null);
        pendingCount = pendingBookingsCount + pendingVerificationsCount + unreadNotificationsCount;
    } catch { }
}

<div id="admin-notification-data" data-count="@pendingCount" style="display:none;"></div>

@* Admin Sidebar - Modern Professional Design *@

<aside class="admin-sidebar" id="adminSidebar">
    <!-- Sidebar Header -->
    <div class="sidebar-header">
        <div class="sidebar-brand">
            <i class="bi bi-car-front-fill sidebar-logo text-primary fs-3"></i>
            <span class="sidebar-brand-text">RentWheels</span>
        </div>
        <button class="sidebar-toggle-btn d-lg-none" id="sidebarClose" aria-label="Close sidebar">
            <i class="bi bi-x-lg"></i>
        </button>
    </div>

    <!-- Admin Profile -->
    <div class="sidebar-profile">
        <div class="profile-avatar">
            <i class="bi bi-person-circle"></i>
        </div>
        <div class="profile-info">
            <span class="profile-name fw-bold">@(User.Identity?.Name ?? "System Admin")</span>
            <span class="profile-role d-flex align-items-center">
                <i class="bi bi-patch-check-fill text-info me-1"></i> Admin
            </span>
        </div>
    </div>

    @{ var currentPath = Context.Request.Path.Value?.ToLower() ?? ""; }
    <!-- Navigation -->
    <nav class="sidebar-nav">
        <!-- Main -->
        <div class="nav-section">
            <span class="nav-section-title">Main</span>
            <a asp-controller="Home" asp-action="Index" class="sidebar-link @(currentPath == "/" || currentPath == "/home" || currentPath == "/home/index" ? "active" : "")">
                <i class="bi bi-speedometer2"></i>
                <span>Dashboard</span>
            </a>
            <a asp-controller="Home" asp-action="AdminNotifications" class="sidebar-link @(currentPath == "/home/adminnotifications" ? "active" : "") d-flex justify-content-between align-items-center w-100">
                <div>
                    <i class="bi bi-bell-fill"></i>
                    <span>Notifications</span>
                </div>
                @if (pendingCount > 0)
                {
                    <span class="text-danger fw-bold ms-auto" style="font-size: 0.9rem;">@pendingCount</span>
                }
            </a>
            <a asp-controller="Account" asp-action="AllUsers" class="sidebar-link @(currentPath == "/account/allusers" ? "active" : "")">
                <i class="bi bi-people-fill"></i>
                <span>Manage Customers</span>
            </a>
        </div>

        <!-- Quick Actions -->
        <div class="nav-section">
            <span class="nav-section-title">Quick Actions</span>
            <a asp-controller="Vehicles" asp-action="Create" class="sidebar-link @(currentPath == "/vehicles/create" ? "active" : "")">
                <i class="bi bi-plus-circle-fill"></i>
                <span>Add New Vehicle</span>
                <small class="sidebar-link-badge">New</small>
            </a>
            <a asp-controller="Bookings" asp-action="AllBookings" class="sidebar-link @(currentPath == "/bookings/allbookings" ? "active" : "")">
                <i class="bi bi-calendar2-check"></i>
                <span>Manage Bookings</span>
            </a>
            <a asp-controller="Payments" asp-action="Index" class="sidebar-link @(currentPath == "/payments" || currentPath == "/payments/index" ? "active" : "")">
                <i class="bi bi-credit-card-2-front"></i>
                <span>View Payments</span>
            </a>
            <a asp-controller="Vehicles" asp-action="Index" class="sidebar-link @(currentPath == "/vehicles" || currentPath == "/vehicles/index" ? "active" : "")">
                <i class="bi bi-car-front-fill"></i>
                <span>Vehicle Fleet</span>
            </a>
        </div>

        <!-- Reports -->
        <div class="nav-section">
            <span class="nav-section-title">Reports & Analytics</span>
            <a asp-controller="Reports" asp-action="Index" class="sidebar-link @(currentPath == "/reports" || currentPath == "/reports/index" ? "active" : "")">
                <i class="bi bi-graph-up-arrow"></i>
                <span>Reports Dashboard</span>
            </a>
            <a asp-controller="Reports" asp-action="VehicleUsage" class="sidebar-link @(currentPath == "/reports/vehicleusage" ? "active" : "")">
                <i class="bi bi-speedometer"></i>
                <span>Vehicle Usage</span>
            </a>
            <a asp-controller="Reports" asp-action="RentalHistory" class="sidebar-link @(currentPath == "/reports/rentalhistory" ? "active" : "")">
                <i class="bi bi-clock-history"></i>
                <span>Rental History</span>
            </a>
            <a asp-controller="Reports" asp-action="PaymentReport" class="sidebar-link @(currentPath == "/reports/paymentreport" ? "active" : "")">
                <i class="bi bi-cash-coin"></i>
                <span>Payment Report</span>
            </a>
        </div>

        <!-- Settings -->
        <div class="nav-section">
            <span class="nav-section-title">Account</span>
            <a asp-controller="Home" asp-action="Privacy" class="sidebar-link @(currentPath == "/home/privacy" ? "active" : "")">
                <i class="bi bi-shield-check"></i>
                <span>Privacy Policy</span>
            </a>
        </div>
    </nav>
    <div class="sidebar-footer">
        <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline w-100">
            @Html.AntiForgeryToken()
            <button type="submit" class="sidebar-link sidebar-logout-btn">
                <i class="bi bi-box-arrow-left"></i>
                <span>Logout</span>
            </button>
        </form>
    </div>
</aside>

<!-- Sidebar Overlay for Mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Script to preserve admin sidebar scroll position across reloads -->
<script>
    (function () {
        const sidebarNav = document.querySelector('.sidebar-nav');
        if (sidebarNav) {
            // Restore scroll position instantly
            const savedScroll = sessionStorage.getItem('adminSidebarScrollPos');
            if (savedScroll) {
                sidebarNav.scrollTop = parseInt(savedScroll, 10);
            }

            // Save scroll position just before page unloads
            window.addEventListener('beforeunload', function () {
                sessionStorage.setItem('adminSidebarScrollPos', sidebarNav.scrollTop);
            });
        }
    })();
</script>

@model List<Booking>
@{
    ViewData["Title"] = "All Bookings";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-journal-text me-2 text-gradient"></i>All Bookings</h2>
    <p>Manage all customer booking requests.</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info animate-fade-in-up">
        <i class="bi bi-info-circle me-2"></i>No bookings yet.
    </div>
}
else
{
    <div class="vrms-table scroll-animate">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Total Cost</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td><strong>#@booking.Id</strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="user-avatar" style="width:32px;height:32px;border-radius:50%;background:var(--gradient);display:flex;align-items:center;justify-content:center;color:white;font-size:0.75rem;font-weight:600;min-width:32px;">
                                        @booking.Customer.FullName.Substring(0,1).ToUpper()
                                    </div>
                                    <span class="ms-2">@booking.Customer.FullName</span>
                                </div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(booking.Vehicle.ImageUrl))
                                    {
                                        <img src="@booking.Vehicle.ImageUrl" alt="@booking.Vehicle.Brand @booking.Vehicle.Model" style="width:36px;height:36px;border-radius:8px;min-width:36px;object-fit:cover;" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="vehicle-img-placeholder @booking.Vehicle.Type.ToString().ToLower()" style="width:36px;height:36px;border-radius:8px;min-width:36px;">
                                            <i class="bi bi-car-front-fill" style="font-size:0.9rem;"></i>
                                        </div>
                                    }
                                    <span class="ms-2"><strong>@booking.Vehicle.Brand</strong> @booking.Vehicle.Model</span>
                                </div>
                            </td>
                            <td>@booking.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@booking.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>@((booking.EndDate - booking.StartDate).Days)</td>
                            <td>
                                <strong>₹@booking.TotalCost.ToString("N2")</strong>
                                @if (booking.DepositAmount > 0)
                                {
                                    <br/><small class="text-muted">+ ₹@booking.DepositAmount.ToString("N2") deposit</small>
                                }
                            </td>
                            <td>
                                @switch (booking.Status)
                                {
                                    case BookingStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case BookingStatus.Approved:
                                        <span class="badge bg-success">Approved</span>
                                        break;
                                    case BookingStatus.Rejected:
                                        <span class="badge bg-danger">Rejected</span>
                                        break;
                                    case BookingStatus.Completed:
                                        <span class="badge bg-info">Completed</span>
                                        @if (booking.IsDepositRefunded)
                                        {
                                            <div class="mt-1">
                                                <small class="text-success fw-bold" style="font-size: 0.75rem;"><i class="bi bi-shield-check"></i> Deposit Actioned</small>
                                            </div>
                                        }
                                        break;
                                        <span class="badge bg-info">Completed</span>
                                        break;
                                    case BookingStatus.Cancelled:
                                        <span class="badge bg-secondary">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (booking.Payment != null)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check me-1"></i>@booking.Payment.Method</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                <div class="d-flex gap-1">
                                    @if (booking.Status == BookingStatus.Pending)
                                    {
                                        <form asp-action="Approve" asp-route-id="@booking.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-success" title="Approve">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                        <form asp-action="Reject" asp-route-id="@booking.Id" method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-danger" title="Reject">
                                                <i class="bi bi-x-lg"></i>
                                            </button>
                                        </form>
                                    }
                                    @if (booking.Status == BookingStatus.Approved && booking.Payment != null && booking.Payment.Status == vehicle_management_system_mvc.Models.PaymentStatus.Completed)
                                    {
                                        <button type="button" class="btn btn-sm btn-info text-white" title="Complete & Return Vehicle" data-bs-toggle="modal" data-bs-target="#completeModal-@booking.Id">
                                            <i class="bi bi-check-circle"></i>
                                        </button>
                                    }
                                    else if (booking.Status == BookingStatus.Approved && (booking.Payment == null || booking.Payment.Status != vehicle_management_system_mvc.Models.PaymentStatus.Completed))
                                    {
                                        <span class="badge bg-warning text-dark"><i class="bi bi-clock-history me-1"></i>Awaiting Payment</span>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modals (Rendered outside the table to prevent backdrop and z-index issues) -->
    @foreach (var booking in Model)
    {
        @if (booking.Status == BookingStatus.Approved && booking.Payment != null && booking.Payment.Status == vehicle_management_system_mvc.Models.PaymentStatus.Completed)
        {
            <!-- Damage Check Modal -->
            <div class="modal fade text-start" id="completeModal-@booking.Id" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true" style="z-index: 1055;">
                <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 shadow-lg" style="border-radius: 12px;">
                    <div class="modal-header bg-light border-0">
                    <h5 class="modal-title fw-bold text-dark"><i class="bi bi-car-front-fill me-2 text-primary"></i>Vehicle Return Check</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center p-4">
                    <div class="mb-3">
                        <i class="bi bi-shield-exclamation text-warning" style="font-size: 3.5rem;"></i>
                    </div>
                    <h5 class="mb-2">Is there any damage to the vehicle?</h5>
                    <p class="text-muted mb-0">Please confirm if the <strong>@booking.Vehicle.Brand @booking.Vehicle.Model</strong> was returned with any new damages.</p>
                    </div>
                    <div class="modal-footer bg-light border-0 d-flex justify-content-center gap-2">
                    <form asp-action="CompleteWithoutDamage" asp-route-id="@booking.Id" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-success px-4 rounded-pill shadow-sm"><i class="bi bi-check-circle me-1"></i>No Damage</button>
                    </form>
                    <form asp-action="Complete" asp-route-id="@booking.Id" method="post" class="m-0">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-danger px-4 rounded-pill shadow-sm"><i class="bi bi-file-earmark-text me-1"></i>Yes, Report Damage</button>
                    </form>
                    </div>
                </div>
                </div>
            </div>
        }
    }
}

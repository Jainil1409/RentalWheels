@model List<Booking>
@{
    ViewData["Title"] = "My Bookings";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-calendar-check me-2 text-gradient"></i>My Bookings</h2>
    <p>Track all your vehicle rental bookings.</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info animate-fade-in-up">
        <i class="bi bi-info-circle me-2"></i>You have no bookings yet.
        <a asp-controller="Vehicles" asp-action="Index" class="fw-semibold">Browse vehicles</a> to get started.
    </div>
}
else
{
    <div class="vrms-table scroll-animate">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Vehicle</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Days</th>
                        <th>Total Cost</th>
                        <th>Status</th>
                        <th>Payment</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td><strong>#@booking.Id</strong></td>
                            <td>
                                <div class="d-flex align-items-center">
                                    @if (!string.IsNullOrEmpty(booking.Vehicle.ImageUrl))
                                    {
                                        <img src="@booking.Vehicle.ImageUrl" alt="@booking.Vehicle.Brand @booking.Vehicle.Model" style="width:40px;height:40px;border-radius:8px;min-width:40px;object-fit:cover;" loading="lazy" />
                                    }
                                    else
                                    {
                                        <div class="vehicle-img-placeholder @booking.Vehicle.Type.ToString().ToLower()" style="width:40px;height:40px;border-radius:8px;min-width:40px;">
                                            <i class="bi bi-car-front-fill" style="font-size:1rem;"></i>
                                        </div>
                                    }
                                    <div class="ms-2">
                                        <strong>@booking.Vehicle.Brand @booking.Vehicle.Model</strong>
                                    </div>
                                </div>
                            </td>
                            <td>@booking.StartDate.ToString("MMM dd, yyyy")</td>
                            <td>@booking.EndDate.ToString("MMM dd, yyyy")</td>
                            <td>@((booking.EndDate - booking.StartDate).Days)</td>
                            <td>
                                <strong>₹@booking.TotalCost.ToString("N2")</strong>
                                @if (booking.DepositAmount > 0)
                                {
                                    <br/><small class="text-muted">+ ₹@booking.DepositAmount.ToString("N2") deposit</small>
                                }
                            </td>
                            <td>
                                @switch (booking.Status)
                                {
                                    case BookingStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case BookingStatus.Approved:
                                        <span class="badge bg-success">Approved</span>
                                        break;
                                    case BookingStatus.Rejected:
                                        <span class="badge bg-danger">Rejected</span>
                                        break;
                                    case BookingStatus.Completed:
                                        <span class="badge bg-info">Completed</span>
                                        @if (booking.IsDepositRefunded)
                                        {
                                            <div class="mt-1">
                                                <small class="text-success fw-bold" style="font-size: 0.75rem;"><i class="bi bi-check-circle"></i> Deposit Actioned</small>
                                            </div>
                                        }
                                        break;
                                    case BookingStatus.Cancelled:
                                        <span class="badge bg-secondary">Cancelled</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (booking.Payment != null)
                                {
                                    <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Paid</span>
                                }
                                else if (booking.Status == BookingStatus.Approved)
                                {
                                    <span class="badge bg-warning">Unpaid</span>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>
                                @if (booking.Status == BookingStatus.Approved && booking.Payment == null)
                                {
                                    <a asp-controller="Payments" asp-action="Create" asp-route-bookingId="@booking.Id" class="btn btn-sm btn-success">
                                        <i class="bi bi-credit-card me-1"></i>Pay
                                    </a>
                                }
                                else if (booking.Status == BookingStatus.Pending)
                                {
                                    <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="bi bi-x-circle me-1"></i>Cancel
                                        </button>
                                    </form>
                                }
                                else if (booking.Payment != null)
                                {
                                    <a asp-controller="Payments" asp-action="Invoice" asp-route-paymentId="@booking.Payment.Id" class="btn btn-sm btn-outline-primary" title="View Invoice">
                                        <i class="bi bi-file-earmark-text me-1"></i>Invoice
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
}

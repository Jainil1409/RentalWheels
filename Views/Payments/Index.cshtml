@model vehicle_management_system_mvc.Helpers.PaginatedList<Payment>
@{
    ViewData["Title"] = "Payments";
}

@if (Model.Count == 0 && ViewBag.DamagePayments?.Count == 0)
{
    <div class="alert alert-info animate-fade-in-up">
        <i class="bi bi-info-circle me-2"></i>No payments recorded yet.
    </div>
}
else
{
    var prevDisabledBooking = !Model.HasPreviousPage ? "disabled" : "";
    var nextDisabledBooking = !Model.HasNextPage ? "disabled" : "";
    var damagePrevDisabled = ViewBag.HasDamagePreviousPage != null && !(bool)ViewBag.HasDamagePreviousPage ? "disabled" : "";
    var damageNextDisabled = ViewBag.HasDamageNextPage != null && !(bool)ViewBag.HasDamageNextPage ? "disabled" : "";
    int damagePage = ViewBag.DamagePageNumber != null ? (int)ViewBag.DamagePageNumber : 1;
    int damageTotalPages = ViewBag.DamageTotalPages != null ? (int)ViewBag.DamageTotalPages : 1;

    <div class="row g-4 mb-4">
        <div class="col-md-3 scroll-animate">
            <div class="stat-card success">
                <div class="stat-icon"><i class="bi bi-cash-stack"></i></div>
                <div class="stat-value" data-count="@Model.Where(p => p.Status == PaymentStatus.Completed).Sum(p => p.Amount)" data-prefix="₹" data-decimals="2">₹0</div>
                <div class="stat-label">Total Collected</div>
            </div>
        </div>
        <div class="col-md-3 scroll-animate">
            <div class="stat-card primary">
                <div class="stat-icon"><i class="bi bi-receipt"></i></div>
                <div class="stat-value" data-count="@Model.Count">0</div>
                <div class="stat-label">Total Transactions</div>
            </div>
        </div>
        <div class="col-md-3 scroll-animate">
            <div class="stat-card info">
                <div class="stat-icon"><i class="bi bi-cash-coin"></i></div>
                <div class="stat-value" data-count="@Model.Count(p => p.Method == PaymentMethod.Cash)">0</div>
                <div class="stat-label">Cash Payments</div>
            </div>
        </div>
        <div class="col-md-3 scroll-animate">
            <div class="stat-card warning">
                <div class="stat-icon"><i class="bi bi-stripe"></i></div>
                <div class="stat-value" data-count="@Model.Count(p => p.Method == PaymentMethod.Stripe)">0</div>
                <div class="stat-label">Stripe Payments</div>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-center mb-4 scroll-animate">
        <div class="btn-group bg-white rounded-pill p-1 shadow-sm border" role="group" aria-label="Payment Toggle" style="border-color: var(--gray-200) !important;">
            <input type="radio" class="btn-check" name="paymentToggle" id="btnBooking" autocomplete="off" checked onchange="togglePaymentTables('booking')">
            <label class="btn toggle-btn rounded-pill px-4 py-2 fw-medium border-0 m-0" for="btnBooking" style="color: #64748b; transition: all 0.3s ease;">
                <i class="bi bi-car-front me-2"></i>Booking Payments
            </label>

            <input type="radio" class="btn-check" name="paymentToggle" id="btnDamage" autocomplete="off" onchange="togglePaymentTables('damage')">
            <label class="btn toggle-btn rounded-pill px-4 py-2 fw-medium border-0 m-0" for="btnDamage" style="color: #64748b; transition: all 0.3s ease;">
                <i class="bi bi-shield-exclamation me-2"></i>Damage Penalties
            </label>
        </div>
    </div>

    <style>
        .btn-check:checked + label[for="btnBooking"] {
            background: linear-gradient(135deg, #0d6efd, #0b5ed7) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(13, 110, 253, 0.25);
        }
        .btn-check:checked + label[for="btnDamage"] {
            background: linear-gradient(135deg, #ef4444, #dc2626) !important;
            color: #ffffff !important;
            box-shadow: 0 4px 12px rgba(239, 68, 68, 0.25);
        }
        .toggle-btn:hover:not(.btn-check:checked + label) {
            background-color: var(--gray-100);
            color: var(--dark) !important;
        }
    </style>

    <div class="card shadow-sm border-0 mb-4 animate-fade-in-up">
        <div class="card-body">
            <form asp-action="Index" method="get" class="d-flex w-100 gap-2">
                <div class="input-group shadow-sm rounded">
                    <input type="text" name="searchString" value="@ViewData["CurrentFilter"]" class="form-control border-0 bg-light" placeholder="Search by customer name, vehicle, or transaction ID...">
                    <button type="submit" class="btn btn-primary px-4 rounded-end"><i class="bi bi-search me-1"></i>Search</button>
                </div>
                @if (!string.IsNullOrEmpty((string?)ViewData["CurrentFilter"]))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary px-4 d-flex align-items-center shadow-sm rounded"><i class="bi bi-x-circle me-2"></i>Clear</a>
                }
            </form>
        </div>
    </div>

    <div class="vrms-table scroll-animate" id="bookingPaymentsTable">
        <div class="table-responsive">
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Customer</th>
                        <th>Vehicle</th>
                        <th>Booking</th>
                        <th>Amount</th>
                        <th>Method</th>
                        <th>Status</th>
                        <th>Invoice</th>
                        <th>Date</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td><strong>#@payment.Id</strong></td>
                            <td>@payment.Booking.Customer.FullName</td>
                            <td>@payment.Booking.Vehicle.Brand @payment.Booking.Vehicle.Model</td>
                            <td>#@payment.BookingId</td>
                            <td><strong>₹@payment.Amount.ToString("N2")</strong></td>
                            <td>
                                @if (payment.Method == PaymentMethod.Stripe)
                                {
                                    <span class="badge bg-primary"><i class="bi bi-stripe me-1"></i>Stripe</span>
                                }
                                else
                                {
                                    <span class="badge bg-success"><i class="bi bi-cash-coin me-1"></i>Cash</span>
                                }
                            </td>
                            <td>
                                @switch (payment.Status)
                                {
                                    case PaymentStatus.Completed:
                                        <span class="badge bg-success">Completed</span>
                                        break;
                                    case PaymentStatus.Pending:
                                        <span class="badge bg-warning">Pending</span>
                                        break;
                                    case PaymentStatus.Failed:
                                        <span class="badge bg-danger">Failed</span>
                                        break;
                                    case PaymentStatus.Refunded:
                                        <span class="badge bg-info">Refunded</span>
                                        break;
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(payment.InvoiceNumber))
                                {
                                    <a asp-action="Invoice" asp-route-paymentId="@payment.Id" class="btn btn-sm btn-outline-primary">
                                        <i class="bi bi-file-earmark-text"></i>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-muted">&mdash;</span>
                                }
                            </td>
                            <td>@payment.PaymentDate.ToString("MMM dd, yyyy HH:mm")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (ViewBag.DamagePayments != null && ((vehicle_management_system_mvc.Helpers.PaginatedList<vehicle_management_system_mvc.Models.DamageReport>)ViewBag.DamagePayments).Any())
    {
        <div class="vrms-table scroll-animate" id="damagePaymentsTable" style="display: none;">
            <div class="table-responsive">
                <table class="table table-hover">
                    <thead class="table-danger">
                        <tr>
                            <th>Report #</th>
                            <th>Customer</th>
                            <th>Vehicle</th>
                            <th>Booking</th>
                            <th>Amount</th>
                            <th>Method</th>
                            <th>Status</th>
                            <th>Invoice</th>
                            <th>Date</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var report in (List<vehicle_management_system_mvc.Models.DamageReport>)ViewBag.DamagePayments)
                        {
                            <tr>
                                <td><strong>DMG-@report.Id</strong></td>
                                <td>@(@report.Booking?.Customer?.FullName ?? "Unknown")</td>
                                <td>@(@report.Booking?.Vehicle?.Brand) @(@report.Booking?.Vehicle?.Model)</td>
                                <td>#@report.BookingId</td>
                                <td class="text-danger"><strong>₹@report.DamageCost.ToString("N2")</strong></td>
                                <td>
                                    <span class="badge bg-secondary">Paid</span>
                                </td>
                                <td>
                                    <span class="badge bg-success">Settled</span>
                                </td>
                                <td>
                                    <a asp-action="DamageInvoice" asp-route-reportId="@report.Id" class="btn btn-sm btn-outline-danger">
                                        <i class="bi bi-file-earmark-pdf"></i> View
                                    </a>
                                </td>
                                <td>@report.CreatedAt.ToString("MMM dd, yyyy HH:mm")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
}

<script>
    function togglePaymentTables(type) {
        const bookingTable = document.getElementById('bookingPaymentsTable');
        const damageTable = document.getElementById('damagePaymentsTable');
        
        if (type === 'booking') {
            if(bookingTable) bookingTable.style.display = 'block';
            if(damageTable) damageTable.style.display = 'none';
        } else {
            if(bookingTable) bookingTable.style.display = 'none';
            if(damageTable) damageTable.style.display = 'block';
        }
    }

    document.addEventListener("DOMContentLoaded", function() {
        const urlParams = new URLSearchParams(window.location.search);
        const tab = urlParams.get('activeTab');
        if (tab === 'damage') {
            const btnDamage = document.getElementById('btnDamage');
            if (btnDamage) {
                btnDamage.checked = true;
                togglePaymentTables('damage');
            }
        }
    });
</script>


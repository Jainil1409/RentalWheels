@model vehicle_management_system_mvc.Models.DamageReport

@{
    ViewData["Title"] = "Pay Damage Penalty";
}

<div class="container py-5">
    <div class="row pt-5 justify-content-center">
        <div class="col-md-7">
            <div class="card shadow border-0 rounded-4">
                <div class="card-header bg-danger text-white py-3 rounded-top-4">
                    <h5 class="mb-0"><i class="bi bi-exclamation-triangle-fill me-2"></i>Damage Penalty Payment</h5>
                </div>
                <div class="card-body p-5">
                    <div class="text-center mb-4">
                        <h2 class="display-4 fw-bold text-dark">₹@Model.DamageCost.ToString("N2")</h2>
                        <p class="text-muted">Total Due</p>
                    </div>

                    <div class="mb-4">
                        <h6 class="fw-bold">Report Details:</h6>
                        <ul class="list-group list-group-flush mb-3">
                            <li class="list-group-item px-0">Vehicle: @(@Model.Booking?.Vehicle?.Brand) @(@Model.Booking?.Vehicle?.Model)</li>
                            <li class="list-group-item px-0">Damage Discovered: <strong class="text-danger">@Model.Description</strong></li>
                        </ul>
                    </div>

                    <form asp-action="ProcessDamagePayment" asp-controller="Payments" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="reportId" value="@Model.Id" />
                        
                        <div class="mb-4">
                            <label class="form-label fw-bold">Select Payment Method</label>
                            
                            <!-- Cash Option -->
                            <div class="form-check custom-radio mb-3 border p-3 rounded-3 hover-shadow-sm">
                                <input class="form-check-input mt-1" type="radio" name="paymentMethod" id="methodCash" value="Cash" checked>
                                <label class="form-check-label w-100 d-flex justify-content-between align-items-center ms-2" for="methodCash">
                                    <div>
                                        <i class="bi bi-cash-stack text-success fs-4 me-2 align-middle"></i>
                                        <span class="fw-medium font-size-lg">Pay with Cash</span>
                                    </div>
                                    <small class="text-muted">Pay at pickup/drop-off</small>
                                </label>
                            </div>

                            <!-- Stripe Option -->
                            <div class="form-check custom-radio border p-3 rounded-3 hover-shadow-sm">
                                <input class="form-check-input mt-1" type="radio" name="paymentMethod" id="methodStripe" value="Stripe">
                                <label class="form-check-label w-100 d-flex justify-content-between align-items-center ms-2" for="methodStripe">
                                    <div>
                                        <i class="bi bi-credit-card-2-front text-primary fs-4 me-2 align-middle"></i>
                                        <span class="fw-medium font-size-lg">Pay Online with Card</span>
                                    </div>
                                    <small class="text-muted">Powered by Stripe</small>
                                </label>
                            </div>
                        </div>

                        <button type="submit" class="btn btn-danger w-100 py-3 fw-bold rounded-pill shadow-sm">
                            Complete Penalty Payment
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .custom-radio {
        transition: all 0.2s ease;
        cursor: pointer;
    }
    .custom-radio:hover {
        border-color: #0d6efd !important;
        background-color: #f8f9fa;
    }
    .custom-radio .form-check-input:checked {
        background-color: #0d6efd;
        border-color: #0d6efd;
    }
</style>
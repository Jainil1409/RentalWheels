@model Vehicle
@{
    ViewData["Title"] = "Delete Vehicle";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-trash me-2 text-gradient"></i>Delete Vehicle</h2>
</div>

<div class="delete-confirm-card animate-scale-in">
    <div class="delete-header">
        <i class="bi bi-exclamation-triangle-fill d-block"></i>
        <h4 class="mb-1">Are you sure?</h4>
        <p class="text-muted mb-0">This action cannot be undone.</p>
    </div>
    <div class="p-4">
        <div class="d-flex align-items-center mb-3">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Brand @Model.Model" style="width:80px;height:80px;border-radius:var(--radius);min-width:80px;object-fit:cover;" loading="lazy" />
            }
            else
            {
                <div class="vehicle-img-placeholder @Model.Type.ToString().ToLower()" style="width:80px;height:80px;border-radius:var(--radius);min-width:80px;">
                    <i class="bi bi-car-front-fill" style="font-size:2rem;"></i>
                </div>
            }
            <div class="ms-3">
                <h4 class="mb-1">@Model.Brand @Model.Model</h4>
                <span class="badge bg-primary">@Model.Type</span>
            </div>
        </div>
        <div class="detail-info-card p-0" style="box-shadow:none;border:1px solid var(--gray-200);">
            <div class="info-row px-3">
                <span class="info-label">Year</span>
                <span class="info-value">@Model.Year</span>
            </div>
            <div class="info-row px-3">
                <span class="info-label">License Plate</span>
                <span class="info-value">@(Model.LicensePlate ?? "N/A")</span>
            </div>
            <div class="info-row px-3">
                <span class="info-label">Price/Day</span>
                <span class="info-value" style="color:var(--primary);font-weight:700;">₹@Model.PricePerDay.ToString("N2")</span>
            </div>
        </div>
        <div class="d-flex gap-2 mt-4">
            <form asp-action="Delete" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />
                <button type="submit" class="btn btn-danger">
                    <i class="bi bi-trash me-1"></i>Confirm Delete
                </button>
            </form>
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Cancel
            </a>
        </div>
    </div>
</div>

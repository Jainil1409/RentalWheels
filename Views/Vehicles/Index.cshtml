@model VehicleSearchViewModel
@{
    ViewData["Title"] = "Vehicles";
}

<div class="d-flex justify-content-between align-items-center mb-4 animate-fade-in-up">
    <div class="section-header mb-0">
        <h2><i class="bi bi-car-front-fill me-2 text-gradient"></i>Our Fleet</h2>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <div class="d-flex gap-2">
            <form asp-action="GenerateRandomCars" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <input type="hidden" name="count" value="5" />
                <button type="submit" class="btn btn-outline-success">
                    <i class="bi bi-dice-5 me-1"></i>Generate Cars
                </button>
            </form>
            <form asp-action="RefreshImages" method="post" class="d-inline">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-primary">
                    <i class="bi bi-arrow-clockwise me-1"></i>Refresh Images
                </button>
            </form>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-circle me-1"></i>Add Vehicle
            </a>
        </div>
    }
</div>

<div class="search-filter-bar animate-fade-in-up">
    <form method="get" asp-action="Index">
        <div class="row g-3 align-items-end">
            <div class="col-md-2">
                <label class="form-label"><i class="bi bi-tag me-1"></i>Brand</label>
                <input asp-for="Brand" class="form-control" placeholder="e.g. Toyota" />
            </div>
            <div class="col-md-2">
                <label class="form-label"><i class="bi bi-grid me-1"></i>Type</label>
                <select asp-for="Type" class="form-select" asp-items="ViewBag.VehicleTypes">
                    <option value="">All Types</option>
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label"><i class="bi bi-arrow-down me-1"></i>Min Price</label>
                <input asp-for="MinPrice" type="number" step="0.01" class="form-control" placeholder="₹10000" />
            </div>
            <div class="col-md-2">
                <label class="form-label"><i class="bi bi-arrow-up me-1"></i>Max Price</label>
                <input asp-for="MaxPrice" type="number" step="0.01" class="form-control" placeholder="₹30000" />
            </div>
            <div class="col-md-2">
                <div class="form-check mt-4">
                    <input asp-for="AvailableOnly" class="form-check-input" type="checkbox" value="true" />
                    <label asp-for="AvailableOnly" class="form-check-label">Available Only</label>
                </div>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-search me-1"></i>Search
                </button>
            </div>
        </div>
    </form>
</div>

@if (Model.Vehicles.Count == 0)
{
    <div class="alert alert-info animate-fade-in-up">
        <i class="bi bi-info-circle me-2"></i>No vehicles found matching your criteria.
    </div>
}
else
{
    <div class="row g-4">
        @foreach (var vehicle in Model.Vehicles)
        {
            <div class="col-lg-4 col-md-6 scroll-animate">
                <div class="vehicle-card">
                    <div class="vehicle-img">
                        @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                        {
                            <img src="@vehicle.ImageUrl" alt="@vehicle.Brand @vehicle.Model" loading="lazy" />
                        }
                        else
                        {
                            <div class="vehicle-img-placeholder @vehicle.Type.ToString().ToLower()">
                                <i class="bi bi-car-front-fill"></i>
                            </div>
                        }
                        @if (vehicle.IsAvailable)
                        {
                            <span class="vehicle-badge available">
                                <i class="bi bi-check-circle me-1"></i>Available
                            </span>
                        }
                        else
                        {
                            <span class="vehicle-badge unavailable">
                                <i class="bi bi-x-circle me-1"></i>Unavailable
                            </span>
                        }
                    </div>
                    <div class="vehicle-card-body">
                        <span class="vehicle-type">@vehicle.Type</span>
                        <h5>@vehicle.Brand @vehicle.Model</h5>
                        <div class="vehicle-year">
                            <i class="bi bi-calendar3 me-1"></i>@vehicle.Year
                            @if (!string.IsNullOrEmpty(vehicle.LicensePlate))
                            {
                                <span class="ms-2"><i class="bi bi-card-text me-1"></i>@vehicle.LicensePlate</span>
                            }
                        </div>
                        <p class="vehicle-description">@vehicle.Description</p>
                        <div class="vehicle-price">₹@vehicle.PricePerDay.ToString("N2") <span>/ day</span></div>
                    </div>
                    <div class="vehicle-card-footer">
                        <div class="d-flex gap-2">
                            <a asp-action="Details" asp-route-id="@vehicle.Id" class="btn btn-outline-primary btn-sm flex-fill">
                                <i class="bi bi-eye me-1"></i>Details
                            </a>
                            @if (User.IsInRole("Admin"))
                            {
                                <a asp-action="Edit" asp-route-id="@vehicle.Id" class="btn btn-outline-warning btn-sm">
                                    <i class="bi bi-pencil"></i>
                                </a>
                                <form asp-action="ToggleAvailability" asp-route-id="@vehicle.Id" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-outline-secondary btn-sm" title="@(vehicle.IsAvailable ? "Mark Unavailable" : "Mark Available")">
                                        <i class="bi bi-toggle-@(vehicle.IsAvailable ? "on" : "off")"></i>
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}

@model Vehicle
@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model}";

    // Auto-generate feature highlights based on vehicle type + price
    var highlights = new List<(string Icon, string Label)>();
    switch (Model.Type)
    {
        case VehicleType.Luxury:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-geo-alt-fill", "GPS Navigation"), ("bi-phone", "Apple CarPlay"), ("bi-star-fill", "Leather Interior"), ("bi-brightness-high", "Sunroof"), ("bi-gear-wide-connected", "Automatic") });
            break;
        case VehicleType.SUV:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-geo-alt-fill", "GPS Navigation"), ("bi-camera-video-fill", "Backup Camera"), ("bi-speedometer2", "Cruise Control"), ("bi-gear-wide-connected", "Automatic"), ("bi-ev-front-fill", "AWD") });
            break;
        case VehicleType.Sedan:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-bluetooth", "Bluetooth"), ("bi-phone", "Apple CarPlay"), ("bi-fuel-pump", "Fuel Efficient"), ("bi-gear-wide-connected", "Automatic"), ("bi-camera-video-fill", "Backup Camera") });
            break;
        case VehicleType.Convertible:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-geo-alt-fill", "GPS Navigation"), ("bi-star-fill", "Leather Interior"), ("bi-speedometer2", "Sport Mode"), ("bi-gear-wide-connected", "Automatic"), ("bi-music-note-beamed", "Premium Audio") });
            break;
        case VehicleType.Truck:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-camera-video-fill", "Backup Camera"), ("bi-ev-front-fill", "4WD"), ("bi-truck", "Tow Package"), ("bi-bluetooth", "Bluetooth"), ("bi-gear-wide-connected", "Automatic") });
            break;
        case VehicleType.Hatchback:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-bluetooth", "Bluetooth"), ("bi-fuel-pump", "Fuel Efficient"), ("bi-phone-fill", "Android Auto"), ("bi-key-fill", "Keyless Entry"), ("bi-gear-wide-connected", "Automatic") });
            break;
        default:
            highlights.AddRange(new[] { ("bi-shield-check", "Airbags"), ("bi-bluetooth", "Bluetooth"), ("bi-geo-alt-fill", "GPS Navigation"), ("bi-gear-wide-connected", "Automatic"), ("bi-camera-video-fill", "Backup Camera"), ("bi-key-fill", "Keyless Entry") });
            break;
    }
    if (Model.PricePerDay >= 20000) { highlights.Add(("bi-thermometer-sun", "Heated Seats")); highlights.Add(("bi-eye-fill", "Blind Spot Monitor")); }

    // Rental perks
    var perks = new[] {
        ("bi-shield-lock-fill", "Fully Insured", "Comprehensive coverage included"),
        ("bi-tools", "24/7 Roadside Assist", "Emergency help anytime"),
        ("bi-arrow-repeat", "Free Cancellation", "Up to 24 hours before pickup"),
        ("bi-speedometer", "Unlimited Mileage", "No extra charges per km")
    };
}

<div class="professional-details-wrapper">
    <nav aria-label="breadcrumb" class="py-3">
        <ol class="breadcrumb mb-0">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house me-1"></i>Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none text-muted">Fleet</a></li>
            <li class="breadcrumb-item active fw-bold text-dark">@Model.Brand @Model.Model</li>
        </ol>
    </nav>

    <div class="row align-items-stretch mb-5 g-4 g-lg-5">
        <!-- Left: Image Presentation -->
        <div class="col-lg-7">
            <div class="car-showcase-box h-100 placeholder-glow position-relative" style="background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%); border-radius: 20px; overflow: hidden; min-height: 400px; display: flex; align-items: center; justify-content: center; box-shadow: inset 0 0 40px rgba(0,0,0,0.02);">
                <div class="showcase-bg-text position-absolute w-100 text-center text-uppercase" style="font-size: 8rem; font-weight: 900; color: rgba(0,0,0,0.03); top: 50%; transform: translateY(-50%); z-index: 1; letter-spacing: -2px;">
                    @Model.Brand
                </div>
                <!-- Status Badge -->
                <div class="position-absolute top-0 start-0 m-4 z-3">
                    @if (Model.IsAvailable)
                    {
                        <span class="badge bg-success bg-opacity-25 text-success px-3 py-2 rounded-pill fw-bold border border-success border-opacity-25">
                            <i class="bi bi-circle-fill me-1 small"></i> Available Now
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-danger bg-opacity-25 text-danger px-3 py-2 rounded-pill fw-bold border border-danger border-opacity-25">
                            <i class="bi bi-dash-circle-fill me-1 small"></i> Currently Booked
                        </span>
                    }
                </div>
                <div class="position-absolute top-0 end-0 m-4 z-3">
                    <span class="badge bg-dark px-3 py-2 rounded-pill text-uppercase letter-spacing-1">@Model.Type</span>
                </div>

                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                {
                    <img src="@Model.ImageUrl" alt="@Model.Brand @Model.Model" class="img-fluid position-relative z-2" style="max-height: 85%; max-width: 90%; object-fit: contain; filter: drop-shadow(0 20px 25px rgba(0,0,0,0.2));" />
                }
                else
                {
                    <i class="bi bi-car-front-fill position-relative z-2 text-secondary" style="font-size: 8rem; opacity: 0.5;"></i>
                }
            </div>
        </div>

        <!-- Right: Primary Info & Booking Card -->
        <div class="col-lg-5">
            <div class="booking-card h-100 p-4 p-xl-5 bg-white border border-light shadow-sm d-flex flex-column" style="border-radius: 20px;">
                <div class="brand-eyebrow text-primary fw-bold text-uppercase tracking-wider mb-1" style="font-size: 0.85rem; letter-spacing: 2px;">
                    @Model.Year Edition
                </div>
                <h1 class="display-5 fw-black mb-3 text-dark" style="font-weight: 800; letter-spacing: -1px;">
                    @Model.Brand <br />
                    <span class="text-secondary" style="font-weight: 300;">@Model.Model</span>
                </h1>

                <div class="price-block mb-4 pb-4 border-bottom">
                    <div class="d-flex align-items-baseline">
                        <span class="fs-1 fw-bold text-dark me-2">₹@Model.PricePerDay.ToString("N0")</span>
                        <span class="text-muted fw-medium">/ day</span>
                    </div>
                    <small class="text-success fw-medium"><i class="bi bi-check2-all me-1"></i>Taxes & insurance included</small>
                </div>

                <div class="quick-specs-grid row g-3 mb-auto">
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="spec-icon-box bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-car-front text-dark fs-5"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block lh-1">Body Type</small>
                                <strong class="text-dark">@Model.Type</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="spec-icon-box bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-gear-wide-connected text-dark fs-5"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block lh-1">Transmission</small>
                                <strong class="text-dark">Auto</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="spec-icon-box bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-fuel-pump text-dark fs-5"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block lh-1">Fuel Type</small>
                                <strong class="text-dark">Petrol/Hybrid</strong>
                            </div>
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="d-flex align-items-center">
                            <div class="spec-icon-box bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 45px; height: 45px;">
                                <i class="bi bi-person-hearts text-dark fs-5"></i>
                            </div>
                            <div>
                                <small class="text-muted d-block lh-1">Seats</small>
                                <strong class="text-dark">5 Adults</strong>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="action-buttons mt-5">
                    @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer") && Model.IsAvailable)
                    {
                        <a asp-controller="Bookings" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn btn-dark w-100 py-3 rounded-3 fw-bold shadow-sm hover-lift text-uppercase" style="letter-spacing: 1px;">
                            Reserve This Vehicle <i class="bi bi-arrow-right ms-2 hide-on-hover"></i>
                        </a>
                    }
                    else if (!Model.IsAvailable)
                    {
                        <button class="btn btn-secondary w-100 py-3 rounded-3 fw-bold text-uppercase" style="letter-spacing: 1px;" disabled>
                            Currently Unavailable
                        </button>
                    }
                    else if (User.Identity?.IsAuthenticated != true)
                    {
                        <a asp-controller="Account" asp-action="Login" class="btn btn-dark w-100 py-3 rounded-3 fw-bold text-uppercase hover-lift">
                            Login to Book
                        </a>
                    }

                    @if (User.IsInRole("Admin"))
                    {
                        <div class="d-flex gap-2 mt-3">
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-warning flex-fill py-2 rounded-3 fw-bold">Edit</a>
                            <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger flex-fill py-2 rounded-3 fw-bold">Delete</a>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>

    <!-- Bottom Section: Info & Features -->
    <div class="row g-5">
        <div class="col-lg-8">
            <h4 class="fw-bold mb-4 border-bottom pb-2">Vehicle Overview</h4>
            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="text-muted fs-5 lh-base mb-5" style="max-width: 90%;">@Model.Description</p>
            }
            else
            {
                <p class="text-muted fs-5 lh-base mb-5" style="max-width: 90%;">
                    Experience the road like never before in the @Model.Year @Model.Brand @Model.Model. Designed with precision, 
                    this premium @Model.Type.ToString().ToLower() delivers a dynamic driving experience while offering maximum comfort. Whether 
                    navigating city streets or cruising highways, its advanced engineering and luxurious interior make every journey extraordinary.
                </p>
            }

            <h4 class="fw-bold mb-4 border-bottom pb-2">Premium Features</h4>
            <div class="row g-4 mb-5">
                @foreach (var h in highlights)
                {
                    <div class="col-sm-6 col-md-4">
                        <div class="p-3 bg-light rounded-3 d-flex align-items-center h-100 feature-hover">
                            <i class="bi @h.Icon text-primary fs-4 me-3"></i>
                            <span class="fw-semibold text-dark">@h.Label</span>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="col-lg-4">
            <div class="bg-white border text-dark p-4 p-xl-5 rounded-4 shadow-sm position-relative overflow-hidden mb-4">
                <div class="position-absolute end-0 bottom-0 mb-4 me-3 z-0" style="opacity: 0.1;">
                    <img src="/images/logo.png" alt="RentWheels" style="width: 140px; filter: grayscale(100%);" />
                </div>
                <h5 class="fw-bold mb-4 position-relative z-1 text-dark">RentWheels Promise</h5>
                
                <ul class="list-unstyled mb-0 position-relative z-1 d-flex flex-column gap-4">
                    @foreach (var perk in perks)
                    {
                        <li class="d-flex align-items-start">
                            <div class="bg-primary bg-opacity-10 rounded-circle d-flex align-items-center justify-content-center mt-1 me-3" style="width: 32px; height: 32px; flex-shrink: 0;">
                                <i class="bi @perk.Item1 text-primary small"></i>
                            </div>
                            <div>
                                <strong class="d-block mb-1 text-dark">@perk.Item2</strong>
                                <span class="text-muted small">@perk.Item3</span>
                            </div>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>
</div>

<style>
    .professional-details-wrapper {
        padding-bottom: 5rem;
    }
    .hover-lift {
        transition: transform 0.2s ease, box-shadow 0.2s ease;
    }
    .hover-lift:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 20px rgba(0,0,0,0.15) !important;
    }
    .feature-hover {
        transition: background-color 0.2s ease, transform 0.2s ease;
        border: 1px solid transparent;
    }
    .feature-hover:hover {
        background-color: #fff !important;
        border-color: #e9ecef;
        transform: translateY(-2px);
        box-shadow: 0 5px 15px rgba(0,0,0,0.05);
    }
    .fw-black {
        font-weight: 900 !important;
    }
</style>

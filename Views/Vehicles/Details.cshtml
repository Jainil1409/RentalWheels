@model Vehicle
@{
    ViewData["Title"] = $"{Model.Brand} {Model.Model}";
}

<nav aria-label="breadcrumb" class="animate-fade-in-down">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index"><i class="bi bi-house me-1"></i>Home</a></li>
        <li class="breadcrumb-item"><a asp-action="Index">Vehicles</a></li>
        <li class="breadcrumb-item active">@Model.Brand @Model.Model</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-7 animate-fade-in-left">
        <div class="detail-img-container">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@Model.ImageUrl" alt="@Model.Brand @Model.Model" />
            }
            else
            {
                <div class="detail-img-placeholder vehicle-img-placeholder @Model.Type.ToString().ToLower()" style="height:350px;border-radius:var(--radius-lg);">
                    <i class="bi bi-car-front-fill"></i>
                </div>
            }
        </div>
    </div>
    <div class="col-lg-5 animate-fade-in-right">
        <div class="detail-info-card">
            <div class="d-flex justify-content-between align-items-start mb-3">
                <div>
                    <span class="badge bg-primary mb-2">@Model.Type</span>
                    <h2 class="mb-0">@Model.Brand @Model.Model</h2>
                </div>
                @if (Model.IsAvailable)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i>Available</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i>Unavailable</span>
                }
            </div>

            <div class="info-row">
                <span class="info-label"><i class="bi bi-calendar3 me-2"></i>Year</span>
                <span class="info-value">@Model.Year</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-grid me-2"></i>Type</span>
                <span class="info-value">@Model.Type</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-card-text me-2"></i>License Plate</span>
                <span class="info-value">@(Model.LicensePlate ?? "N/A")</span>
            </div>
            <div class="info-row">
                <span class="info-label"><i class="bi bi-cash-stack me-2"></i>Price Per Day</span>
                <span class="info-value" style="font-family:'Poppins',sans-serif;font-size:1.4rem;font-weight:700;color:var(--primary);">₹@Model.PricePerDay.ToString("N2")</span>
            </div>

            @if (!string.IsNullOrEmpty(Model.Description))
            {
                <div class="mt-3 pt-3" style="border-top:1px solid var(--gray-100);">
                    <h6 class="text-muted mb-2"><i class="bi bi-text-paragraph me-1"></i>Description</h6>
                    <p class="mb-0" style="color:var(--gray-600);line-height:1.7;">@Model.Description</p>
                </div>
            }

            <div class="d-flex gap-2 mt-4">
                @if (User.Identity?.IsAuthenticated == true && User.IsInRole("Customer") && Model.IsAvailable)
                {
                    <a asp-controller="Bookings" asp-action="Create" asp-route-vehicleId="@Model.Id" class="btn btn-primary flex-fill">
                        <i class="bi bi-calendar-plus me-1"></i>Book Now
                    </a>
                }
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                        <i class="bi bi-pencil me-1"></i>Edit
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Delete
                    </a>
                }
                <a asp-action="Index" class="btn btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i>Back
                </a>
            </div>
        </div>
    </div>
</div>

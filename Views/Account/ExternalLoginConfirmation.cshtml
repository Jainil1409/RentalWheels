@model vehicle_management_system_mvc.ViewModels.ExternalLoginConfirmationViewModel
@{
    ViewData["Title"] = "Complete Registration";
}

<div class="auth-page">
    <div class="auth-card" style="max-width: 520px;">
        <img src="~/images/logo.png" alt="RentWheels" class="auth-logo" />
        <h3>Complete Registration</h3>
        <p class="auth-subtitle">Welcome, @Model.FullName! Please provide your phone number to complete your registration with Google.</p>
        
        <form asp-action="ExternalLoginConfirmationPost" asp-route-returnurl="@ViewData["ReturnUrl"]" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
            
            <input type="hidden" asp-for="Email" />
            <input type="hidden" asp-for="FullName" />

            <div class="mb-3 text-muted bg-light p-3 rounded border">
                <div class="d-flex align-items-center mb-2">
                    <img src="https://www.svgrepo.com/show/475656/google-color.svg" alt="Google" style="width: 20px; height: 20px;" class="me-2" />
                    <strong>Google Account Connected</strong>
                </div>
                <div><i class="bi bi-person me-2"></i>@Model.FullName</div>
                <div><i class="bi bi-envelope me-2"></i>@Model.Email</div>
            </div>

            <div class="mb-4">
                <label asp-for="Phone" class="form-label fw-bold"><i class="bi bi-telephone me-1 text-primary"></i>Phone Number <span class="text-danger">*</span></label>
                <input asp-for="Phone" class="form-control form-control-lg" placeholder="10-digit phone number" autofocus />
                <span asp-validation-for="Phone" class="text-danger small"></span>
                <div class="form-text mt-2"><i class="bi bi-info-circle me-1"></i>A valid phone number is required for vehicle rental tracking and emergency contact.</div>
            </div>

            <button type="submit" class="btn btn-primary w-100 btn-lg">
                <i class="bi bi-check-circle me-2"></i>Complete Registration
            </button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

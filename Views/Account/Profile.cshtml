@model vehicle_management_system_mvc.ViewModels.UserProfileViewModel
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4 animate-fade-in-up">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex flex-wrap align-items-center justify-content-between bg-white p-4 rounded-4 shadow-sm border border-light gap-3">
                <div class="d-flex align-items-center gap-4">
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold fs-2 shadow-sm" style="width: 80px; height: 80px; flex-shrink: 0;">
                        @(string.IsNullOrEmpty(Model.FullName) ? "U" : Model.FullName.Substring(0, 1).ToUpper())
                    </div>
                    <div>
                        <h2 class="mb-1 fw-bold text-dark">@Model.FullName</h2>
                        <p class="text-muted mb-0 d-flex align-items-center gap-2">
                            <i class="bi bi-envelope"></i> @Model.Email
                        </p>
                    </div>
                </div>
                <div class="text-md-end text-start">
                    @if (Model.IsVerified)
                    {
                        <span class="badge bg-success-subtle text-success py-2 px-3 rounded-pill fs-6 border border-success border-opacity-25">
                            <i class="bi bi-shield-check me-2"></i>Verified Driver
                        </span>
                        <p class="text-muted small mt-2 mb-0">You are cleared for all bookings.</p>
                    }
                    else if (!string.IsNullOrEmpty(Model.DriverLicenseNumber))
                    {
                        <span class="badge bg-warning-subtle text-warning-emphasis py-2 px-3 rounded-pill fs-6 border border-warning border-opacity-25">
                            <i class="bi bi-hourglass-split me-2"></i>Under Admin Review
                        </span>
                        <p class="text-danger small mt-2 mb-0 fw-medium">Admin verification is required before you can book vehicles.</p>
                    }
                    else
                    {
                        <span class="badge bg-danger-subtle text-danger py-2 px-3 rounded-pill fs-6 border border-danger border-opacity-25">
                            <i class="bi bi-exclamation-circle me-2"></i>Profile Incomplete
                        </span>
                        <p class="text-danger small mt-2 mb-0 fw-medium">Admin verification is required before you can book vehicles.</p>
                    }
                </div>
            </div>
        </div>
    </div>

    <form asp-action="Profile" method="post" enctype="multipart/form-data">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
        <div class="row g-4 d-flex align-items-stretch">
            <!-- Left Column: Personal Info -->
            <div class="col-lg-5">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-person-badge text-primary me-2"></i>Personal Details
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="mb-4">
                            <label asp-for="FullName" class="form-label text-muted small fw-bold text-uppercase tracking-wide mb-1">Full Name</label>
                            <input asp-for="FullName" class="form-control form-control-lg bg-light border-0" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>
                        <div class="mb-4">
                            <label asp-for="Phone" class="form-label text-muted small fw-bold text-uppercase tracking-wide mb-1">Phone Number</label>
                            <input asp-for="Phone" class="form-control form-control-lg bg-light border-0" />
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>
                        <div class="mb-2">
                            <label asp-for="Email" class="form-label text-muted small fw-bold text-uppercase tracking-wide mb-1">Email Address</label>
                            <input asp-for="Email" class="form-control form-control-lg bg-secondary bg-opacity-10 border-0 text-muted" readonly />
                            <div class="form-text small mt-2"><i class="bi bi-info-circle me-1"></i>Email cannot be changed after registration.</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Column: Driver Info -->
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm rounded-4 h-100">
                    <div class="card-header bg-white border-bottom-0 pt-4 pb-0 px-4">
                        <h5 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-card-heading text-primary me-2"></i>Driver Information
                        </h5>
                    </div>
                    <div class="card-body p-4">
                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="DriverLicenseNumber" class="form-label text-muted small fw-bold text-uppercase tracking-wide mb-1">License No. *</label>
                                <input asp-for="DriverLicenseNumber" class="form-control form-control-lg bg-light border-0" placeholder="e.g. DL-123456" />
                                <span asp-validation-for="DriverLicenseNumber" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LicenseExpiryDate" class="form-label text-muted small fw-bold text-uppercase tracking-wide mb-1">Expiry Date *</label>
                                <input asp-for="LicenseExpiryDate" class="form-control form-control-lg bg-light border-0" type="date" />
                                <span asp-validation-for="LicenseExpiryDate" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Address" class="form-label text-muted small fw-bold text-uppercase tracking-wide mb-1">Residential Address *</label>
                            <textarea asp-for="Address" class="form-control bg-light border-0" rows="3" placeholder="Enter your full street address"></textarea>
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>

                        <div class="border rounded-4 p-4 bg-light">
                            <label asp-for="IdProofImage" class="form-label text-dark fw-bold mb-2">Identity Proof Document</label>
                            <p class="text-muted small mb-3">Upload a clear photo or scan of your driver's license (JPG, PNG).</p>
                            
                            <input asp-for="IdProofImage" class="form-control mb-3" type="file" accept="image/*" />
                            
                            @if (!string.IsNullOrEmpty(Model.ExistingIdProofUrl))
                            {
                                <div class="d-flex align-items-center gap-3 p-3 bg-white border rounded-3 shadow-sm">
                                    <div class="bg-success-subtle p-2 rounded text-success d-flex align-items-center justify-content-center">
                                        <i class="bi bi-file-earmark-check fs-4"></i>
                                    </div>
                                    <div class="flex-grow-1">
                                        <h6 class="mb-0 fw-bold text-dark">Document Uploaded</h6>
                                        <small class="text-muted">Currently on file</small>
                                    </div>
                                    <button type="button" class="btn btn-sm btn-outline-primary fw-medium" data-bs-toggle="modal" data-bs-target="#imagePreviewModal">
                                        <i class="bi bi-eye me-1"></i> View
                                    </button>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-12 mt-4 text-end">
                <button type="submit" class="btn btn-primary px-5 py-3 rounded-pill fw-bold shadow-sm d-inline-flex align-items-center transition-all">
                    <i class="bi bi-check2-circle me-2 fs-5"></i> Save & Update Profile
                </button>
            </div>
        </div>
    </form>
</div>

@if (!string.IsNullOrEmpty(Model.ExistingIdProofUrl))
{
    <!-- Modal for Image Preview -->
    <div class="modal fade" id="imagePreviewModal" tabindex="-1" aria-labelledby="imagePreviewModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 shadow-lg border-radius-xl">
                <div class="modal-header border-bottom-0 pb-0">
                    <h5 class="modal-title fw-bold" id="imagePreviewModalLabel">Identity Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center p-4">
                    <img src="@Model.ExistingIdProofUrl" alt="ID Proof" class="img-fluid rounded shadow-sm border border-light" style="max-height: 70vh; object-fit: contain;" />
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
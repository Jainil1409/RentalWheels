@{
    ViewData["Title"] = "Privacy Policy";
}

<div class="section-header animate-fade-in-up">
    <h2><i class="bi bi-shield-check me-2 text-gradient"></i>Privacy Policy</h2>
    <p>Your privacy matters to us. Here's how we protect your data.</p>
</div>

<div class="row g-4">
    <div class="col-lg-8 scroll-animate">
        <div class="vrms-form-card">
            <h4 class="mb-3"><i class="bi bi-collection me-2 text-gradient"></i>Data Collection</h4>
            <p class="text-muted">We collect only essential information required to provide our vehicle rental services, including your name, email address, phone number, and booking details.</p>
            <hr />
            <h4 class="mb-3"><i class="bi bi-lock-fill me-2 text-gradient"></i>Data Protection</h4>
            <p class="text-muted">Your personal information is securely stored and never shared with third parties without your consent. We use industry-standard security measures to protect your data.</p>
            <hr />
            <h4 class="mb-3"><i class="bi bi-cookie me-2 text-gradient"></i>Cookies</h4>
            <p class="text-muted">We use essential cookies to maintain your session and improve your browsing experience. No tracking cookies are used without your explicit consent.</p>
            <hr />
            <h4 class="mb-3"><i class="bi bi-envelope-paper me-2 text-gradient"></i>Contact Us</h4>
            <p class="text-muted">If you have any questions about our privacy practices, please contact us at <strong>support&#64;rentwheels.com</strong>.</p>
        </div>
    </div>
    <div class="col-lg-4 scroll-animate">
        <div class="stat-card primary mb-3">
            <div class="stat-icon"><i class="bi bi-shield-lock-fill"></i></div>
            <div class="stat-label">256-bit SSL Encryption</div>
        </div>
        <div class="stat-card success mb-3">
            <div class="stat-icon"><i class="bi bi-check-circle-fill"></i></div>
            <div class="stat-label">GDPR Compliant</div>
        </div>
        <div class="stat-card info">
            <div class="stat-icon"><i class="bi bi-eye-slash-fill"></i></div>
            <div class="stat-label">No Third-Party Tracking</div>
        </div>
    </div>
</div>

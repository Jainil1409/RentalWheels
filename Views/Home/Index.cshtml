@model List<Vehicle>
@{
    ViewData["Tittle"] = "Home";
}

@if (TempData["PendingVerification"] != null)
{
    <div class="alert alert-warning alert-dismissible fade show text-center rounded-0 mb-0 shadow-sm border-0 border-bottom border-warning" role="alert" style="z-index: 1050; position: relative; background-color: #fffbdf;">
        <i class="bi bi-clock-history me-2 fs-5 text-warning align-middle"></i>
        <strong>Registration Successful!</strong> Your account is currently pending admin verification. Feel free to explore our vehicles, you will be able to book once your details are verified.
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="hero-driveonix">
    <div class="hero-bg-text">Drive</div>
    <div class="container-fluid px-4 px-xl-5 hero-container">
        <!-- Left Side -->
        <div class="hero-left">
            <h1 class="hero-title">Your Journey,<br>Your Car,<br>Your Way</h1>
            <p class="hero-desc">Premium vehicles at your fingertips. Discover a seamless rental process with transparent pricing and instant approvals tailored just for you.</p>
            <div class="hero-action mt-4">
                @if (User.Identity?.IsAuthenticated != true)
                {
                    <a asp-controller="Account" asp-action="Register" class="btn-get-started">Get Started</a>
                }
                else
                {
                    <a asp-controller="Vehicles" asp-action="Index" class="btn-get-started">Browse Vehicles</a>
                }
            </div>
        </div>

        <!-- Center Image -->
        <div class="hero-center">
            <!-- Using a classic blue Mercedes placeholder similar to the reference design -->
            <img src="https://freepngimg.com/save/31599-mercedes-car-transparent-background/1000x386" style="filter: hue-rotate(180deg) saturate(3) brightness(1.1) drop-shadow(0 20px 30px rgba(0,0,0,0.3));" alt="Hero Car" class="hero-car-img" onerror="this.src='https://pngimg.com/uploads/mercedes/mercedes_PNG80135.png'" />
        </div>

        <!-- Right Side -->
        <div class="hero-right">
            <div class="hero-reviews d-flex flex-column align-items-lg-end text-lg-end mb-4">
                <div class="review-avatars d-flex mb-2">
                    <img src="https://randomuser.me/api/portraits/men/32.jpg" alt="User" />
                    <img src="https://randomuser.me/api/portraits/women/44.jpg" alt="User" />
                    <img src="https://randomuser.me/api/portraits/women/68.jpg" alt="User" />
                </div>
                <h4 class="fw-bold mb-1" style="font-size:1.1rem; color: #333;">12.5K People</h4>
                <p class="text-muted mb-0" style="font-size: 0.75rem; line-height: 1.4; max-width: 200px;">Have already chosen us for their incredible journeys and smart drives.</p>
            </div>
            
            <ul class="hero-features list-unstyled">
                <li><i class="bi bi-arrow-right text-blue me-2 fw-bold"></i> Above And Beyond</li>
                <li><i class="bi bi-arrow-right text-blue me-2 fw-bold"></i> The Glorious Speed</li>
                <li><i class="bi bi-arrow-right text-blue me-2 fw-bold"></i> Ride Like Boss</li>
                <li><i class="bi bi-arrow-right text-blue me-2 fw-bold"></i> Speed Up The Future</li>
            </ul>
        </div>
    </div>
</div>

<style>
    .hero-driveonix {
        background: transparent;
        position: relative;
        overflow: hidden;
        padding: 9rem 0 6rem 0; /* Increased top/bottom padding to fix conflict */
        margin-bottom: 4rem; /* Safe distance from below sections */
        min-height: 85vh;
        display: flex;
        align-items: center;
        margin-top: -60px; /* Pull up to integrate with navbar space */
    }
    
    .hero-bg-text {
        position: absolute;
        top: 0;
        left: 50%;
        transform: translateX(-50%);
        font-size: 26vw;
        color: rgba(43, 115, 246, 0.03);
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        font-weight: 900;
        letter-spacing: -5px;
        z-index: 0;
        pointer-events: none;
        user-select: none;
    }

    .hero-container {
        position: relative;
        z-index: 2;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        max-width: 1700px; /* Greatly expanded max-width to remove congestion */
        margin: 0 auto;
        width: 100%;
    }

    .hero-left {
        flex: 1 1 350px;
        max-width: 480px; /* Spaced out left column */
        position: relative;
        z-index: 6;
    }
    
    .hero-title {
        font-size: 4rem;
        font-weight: 800;
        color: #2b73f6;
        line-height: 1.15;
        margin-bottom: 1.2rem;
        letter-spacing: -1px;
    }

    .hero-desc {
        font-size: 1.05rem;
        color: #555;
        line-height: 1.7;
        font-weight: 500;
    }

    .btn-get-started {
        display: inline-block;
        background-color: #2b73f6;
        color: #fff;
        font-weight: 600;
        padding: 0.9rem 2.8rem;
        border-radius: 50px;
        text-decoration: none;
        font-size: 1.05rem;
        box-shadow: 0 10px 20px rgba(43, 115, 246, 0.3);
        transition: all 0.3s ease;
    }
    .btn-get-started:hover {
        background-color: #1d5ed8;
        color: #fff;
        transform: translateY(-2px);
        box-shadow: 0 12px 25px rgba(43, 115, 246, 0.4);
    }

    .hero-center {
        flex: 1 1 500px;
        display: flex;
        justify-content: center;
        position: relative;
        z-index: 5;
        padding: 0 2rem;
    }
    
    .hero-car-img {
        width: 100%; /* Changed from 120% to prevent overlap conflicts */
        max-width: 900px; /* Kept large but constrained */
        height: auto;
        transform: translateY(15px);
    }

    .hero-right {
        flex: 1 1 300px;
        max-width: 320px; /* Slightly wider right column */
        display: flex;
        flex-direction: column;
        position: relative;
        z-index: 6;
    }

    .text-blue { color: #2b73f6 !important; }

    .review-avatars img {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        border: 2px solid #fff;
        box-shadow: 0 4px 10px rgba(0,0,0,0.1);
        margin-left: -12px;
    }
    .review-avatars img:first-child { margin-left: 0; }

    .hero-features {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
        align-items: flex-end;
    }
    
    .hero-features li {
        background: #fff;
        padding: 0.65rem 1.25rem;
        border-radius: 50px;
        font-size: 0.85rem;
        font-weight: 600;
        color: #444;
        box-shadow: 0 8px 25px rgba(0,0,0,0.03);
        display: inline-flex;
        align-items: center;
        transition: transform 0.2s;
    }
    
    .hero-features li:hover {
        transform: translateX(-5px);
    }
    
    @@media (max-width: 1199px) {
        .hero-title { font-size: 2.8rem; }
        .hero-car-img { transform: scale(1); width: 100%; }
        .hero-right { max-width: 300px; }
    }

    @@media (max-width: 991px) {
        .hero-driveonix {
            padding: 8rem 0 4rem 0;
            min-height: auto;
            text-align: center;
        }
        .hero-container {
            justify-content: center;
            gap: 3rem;
        }
        .hero-left {
            max-width: 100%;
            text-align: center;
        }
        .hero-right {
            max-width: 100%;
            align-items: center;
            text-align: center;
        }
        .hero-reviews {
            align-items: center !important;
            text-align: center !important;
        }
        .hero-features {
            align-items: center;
        }
        .hero-center {
            padding: 0;
        }
    }

    @@media (max-width: 576px) {
        .hero-title { font-size: 2.2rem; }
        .hero-desc { font-size: 0.95rem; }
        .btn-get-started { padding: 0.8rem 2rem; font-size: 1rem; }
        .hero-bg-text { font-size: 35vw; top: 10%; }
        .hero-car-img { margin-top: 1rem; }
    }
    }
    
    @@media (max-width: 991px) {
        .hero-container {
            flex-direction: column;
            text-align: center;
            gap: 2rem;
            padding-top: 2rem;
        }
        .hero-left {
            align-items: center;
            max-width: 100%;
        }
        .hero-right {
            align-items: center;
            max-width: 100%;
            margin-top: 1rem;
        }
        .hero-reviews {
            align-items: center !important;
            text-align: center !important;
        }
        .hero-features {
            align-items: center;
        }
        .hero-car-img {
            max-width: 90%;
            transform: translateY(0);
        }
        .hero-bg-text {
            font-size: 35vw;
        }
    }
</style>

<!-- Stats Section -->
<div class="container">
    <div class="row g-4 mb-5">
        <div class="col-md-3 col-6">
            <div class="stat-card primary text-center">
                <div class="stat-icon mx-auto"><i class="bi bi-car-front-fill"></i></div>
                <div class="stat-value" data-count="@Model.Count">0</div>
                <div class="stat-label">Available Vehicles</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card success text-center">
                <div class="stat-icon mx-auto"><i class="bi bi-shield-check"></i></div>
                <div class="stat-value">100%</div>
                <div class="stat-label">Verified & Insured</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card warning text-center">
                <div class="stat-icon mx-auto"><i class="bi bi-clock"></i></div>
                <div class="stat-value">24/7</div>
                <div class="stat-label">Support Available</div>
            </div>
        </div>
        <div class="col-md-3 col-6">
            <div class="stat-card info text-center">
                <div class="stat-icon mx-auto"><i class="bi bi-star-fill"></i></div>
                <div class="stat-value">4.9</div>
                <div class="stat-label">Customer Rating</div>
            </div>
        </div>
    </div>

    @if (Model.Count > 0)
    {
        <div class="featured-section">
            <div class="section-title">
                <i class="bi bi-fire text-gradient" style="font-size: 1.5rem;"></i>
                Featured Available Vehicles
            </div>
            <div class="row g-4">
                @foreach (var vehicle in Model)
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="vehicle-card">
                            <div class="vehicle-img">
                                @if (!string.IsNullOrEmpty(vehicle.ImageUrl))
                                {
                                    <img src="@vehicle.ImageUrl" alt="@vehicle.Brand @vehicle.Model" loading="lazy" />
                                }
                                else
                                {
                                    <div class="vehicle-img-placeholder @vehicle.Type.ToString().ToLower()">
                                        <i class="bi bi-car-front-fill"></i>
                                    </div>
                                }
                                <span class="vehicle-badge available">
                                    <i class="bi bi-check-circle me-1"></i>Available
                                </span>
                            </div>
                            <div class="vehicle-card-body">
                                <span class="vehicle-type">@vehicle.Type</span>
                                <h5>@vehicle.Brand @vehicle.Model</h5>
                                <div class="vehicle-year"><i class="bi bi-calendar3 me-1"></i>@vehicle.Year</div>
                                <p class="vehicle-description">@vehicle.Description</p>
                                <div class="vehicle-price">₹@vehicle.PricePerDay.ToString("N2") <span>/ day</span></div>
                            </div>
                            <div class="vehicle-card-footer">
                                <a asp-controller="Vehicles" asp-action="Details" asp-route-id="@vehicle.Id"
                                   class="btn btn-outline-primary w-100">
                                    <i class="bi bi-eye me-1"></i>View Details
                                </a>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>

        <div class="text-center mt-4 mb-4">
            <a asp-controller="Vehicles" asp-action="Index" class="btn btn-primary btn-lg">
                <i class="bi bi-grid me-2"></i>View All Vehicles
            </a>
        </div>
    }
</div>
